#!/usr/bin/env bash
# Rejects commits that add something that looks like an API key.
# Enable it once per clone with:  git config core.hooksPath .githooks
set -euo pipefail

pattern='(sk-ant-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{20,}|gsk_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|hf_[A-Za-z0-9]{30,}|gh[pousr]_[A-Za-z0-9]{30,})'

if matches=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -v '^+++' | grep -E "$pattern"); then
    echo "pre-commit: staged changes contain what looks like an API key:" >&2
    echo "$matches" | sed -E "s/$pattern/<redacted>/g" >&2
    echo "Remove it (the app reads keys from the Keychain at runtime)," >&2
    echo "or commit with --no-verify if this is a false positive." >&2
    exit 1
fi
